# ── Google (free) ────────────────────────────────────────────────────────────
# API key with "PageSpeed Insights API" and "Chrome UX Report API" enabled.
# Without it, Google rejects most PageSpeed requests with HTTP 429.
PSI_API_KEY=
# Parallel PageSpeed calls (Google quota is about 400 per 100 seconds per project)
PSI_CONCURRENCY=8

# ── Owner mode: full catalog via the Shopify Admin API (optional) ────────────
# Token from an app installed on YOUR store, read-only scopes:
# read_products, read_content, read_themes. Used only when auditing this store.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Max products read per run
OWNER_MAX_PRODUCTS=1000

# ── Browser tests (Playwright with an installed Chrome/Edge/Chromium) ────────
# Leave empty to auto-detect the usual install locations.
CHROME_PATH=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Default Slack/Discord/Teams webhook for regression alerts (schedules can set their own)
ALERT_WEBHOOK_URL=
# Public URL of this tool, used for links inside alerts
PUBLIC_BASE_URL=http://localhost:3000

# ── Crawling ─────────────────────────────────────────────────────────────────
# Max time to wait for Shopify's per-IP rate limit on product/collection pages before finishing without them
CRAWL_MAX_WAIT_MS=120000
# Pages still blocked can reuse a successful crawl of the same URL from a run in the last N hours (0 = off)
CRAWL_CACHE_HOURS=72
# Max products read from the public /products.json feed (250 per request)
FEED_MAX_PRODUCTS=5000

# ── Access & safety ──────────────────────────────────────────────────────────
# Without APP_PASSWORD the tool only answers on localhost. Set it before exposing the server.
APP_PASSWORD=
# Optional user name for the sign-in prompt (any name is accepted when empty)
APP_USER=
# Audits per client IP per hour, and max audits queued or running server-wide
RUNS_PER_HOUR=30
MAX_PENDING_RUNS=12
# 1 = allow auditing localhost/private addresses (local development only; never in production)
ALLOW_PRIVATE_TARGETS=

# ── Server ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2
DATA_DIR=./.data

# ── Live mode (no storage) ───────────────────────────────────────────────────
# none = nothing is saved: each audit streams into the browser tab that started it and is gone
# when the tab closes. Automatic on Vercel; set STORAGE=disk there only with a persistent disk.
STORAGE=
# Live audits stop starting new tests after this many seconds (keep below the host's limit, 300 on Vercel)
AUDIT_TIME_BUDGET_SECONDS=230
# Page limit for live audits
LIVE_MAX_PAGES=30

# ── Ahrefs (optional) ────────────────────────────────────────────────────────
# Keys from Ahrefs → Account settings → API keys. Set ONE of them; the report shows what that key unlocks.
# Free Ahrefs account → Domain Rating only (no API units used)
AHREFS_FREE_API_KEY=
# Plan with API access (Lite or higher) → Domain Rating + backlinks, organic traffic, top pages, keywords
# (4 requests per audit, at least 50 API units each). Used instead of the free key when both are set.
AHREFS_PAID_API_KEY=

# ── Semrush (optional) ───────────────────────────────────────────────────────
# Semrush has no free API: needs the SEO Toolkit Business plan plus API units (Subscription info → API units).
# Key from https://www.semrush.com/accounts/api-keys/active. Not set → no Semrush requests, no Semrush tab.
SEMRUSH_API_KEY=
# Country database for keyword data (us, uk, de, pk, …). Empty = from the domain (.de → de), else us.
SEMRUSH_DATABASE=
# Rows per audit (10 API units each). With the defaults an audit uses about 355 units.
SEMRUSH_KEYWORDS=20
SEMRUSH_PAGES=10

# ── Google: Search Console, GA4, Merchant Center (optional, free) ──────────────
# One Google Cloud service account for all three (setup: docs/SEARCH_CONSOLE.md and docs/SEO_AI_INTEGRATIONS.md).
# Store owners add its email to Search Console / GA4 (Viewer) / Merchant Center. Set ONE of these:
# The JSON key itself (one line) or base64 of it — use this on Vercel. (GSC_SERVICE_ACCOUNT_JSON also works.)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or a path to the JSON key file (local / self-hosted). Keep the file out of git. (GSC_SERVICE_ACCOUNT_FILE also works.)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Search Console (on when a key is set): days of data, top queries/pages, URLs to run through URL Inspection (0 = off)
GSC_DAYS=28
GSC_ROWS=25
GSC_INSPECT_URLS=5
# GA4 (off by default). Optional per-store property IDs: store.com=123456789, other.com=987654321
GA4_ENABLED=false
GA4_PROPERTIES=
GA4_DAYS=28
# Session sources counted as AI referrals (comma list; empty = built-in list)
GA4_AI_SOURCES=
# Merchant Center via the Merchant API (off by default). Optional per-store account IDs: store.com=123456789
MERCHANT_ENABLED=false
MERCHANT_ACCOUNTS=
MERCHANT_DAYS=28

# ── AI visibility: ChatGPT / Perplexity / Gemini answers (optional, pay per use) ─
# Any engine whose key is set is asked the same buyer questions with web search on.
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Questions per audit (API calls = questions × engines) and calls in flight
AI_PROBE_MAX_PROMPTS=8
AI_PROBE_CONCURRENCY=6

# ── Google AI Overviews via DataForSEO (optional, pay per request) ─────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AIO_MAX_KEYWORDS=10
# Google location code (empty = from the domain's country, else 2840 = United States), language, device
AIO_LOCATION_CODE=
AIO_LANGUAGE=en
AIO_DEVICE=desktop

# ── Otterly.AI (optional; reads an existing Otterly brand report) ──────────────
OTTERLY_API_KEY=
# Optional per-store report IDs: store.com=<report id>
OTTERLY_REPORTS=
OTTERLY_COUNTRY=us
OTTERLY_DAYS=28

# ── Development only: dummy data for every third-party source ───────────────────
# Points all of the above at the local mock server (node scripts/mock-apis.mjs). Ignored in production builds.
# MOCK_API_BASE=http://127.0.0.1:4010

# Schema tab "Test a URL" (per client IP per hour)
SCHEMA_TESTS_PER_HOUR=
